app MultiStateAlarm initial state off {
    bricks
        Actuator red_led : 12
        Actuator buzzer : 10
        Sensor button : 8
    
    states
        off {
            red_led <= LOW
            buzzer <= LOW
            button is HIGH => buzz
        }
        buzz {
            buzzer <= HIGH
            red_led <= LOW
            button is HIGH => led
        }
        led {
            buzzer <= LOW
            red_led <= HIGH
            button is HIGH => off
        }
}
